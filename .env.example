# Railway Postgres
DATABASE_URL=postgresql://user:password@host:port/dbname

# LLM inference — LLM_PROVIDER selects the backend (openai | anthropic; default
# openai). Per-stage model IDs live in src/infra/llm/providers.ts. The active
# provider's key must be set; the other may stay empty. A provider flip is an
# eval-gated rollout, not just this file — see docs/research/llm-provider-portability.md §3.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
